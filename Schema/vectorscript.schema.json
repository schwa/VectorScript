                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[rx, ry]"
                }
              ]
            },
            "fill": {
              "$ref": "#/$defs/paint"
            },
            "stroke": {
              "$ref": "#/$defs/paint"
            },
            "strokeWidth": {
              "type": "number",
              "minimum": 0
            },
            "strokeCap": {
              "enum": [
                "butt",
                "round",
                "square"
              ]
            },
            "strokeJoin": {
              "enum": [
                "miter",
                "round",
                "bevel"
              ]
            },
            "strokeMiterLimit": {
              "type": "number",
              "minimum": 1
            },
            "strokeDash": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "strokeDashOffset": {
              "type": "number"
            },
            "fillRule": {
              "$ref": "#/$defs/fillRule"
            },
            "font": {
              "type": "string",
              "description": "System font PostScript, family or full name. Default Helvetica."
            },
            "fontSize": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "transform": {
              "$ref": "#/$defs/transform"
            },
            "clip": {
              "$ref": "#/$defs/clip"
            }
