            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "SVG path data (M L H V C S Q T A Z)."
            },
            "fillRule": {
              "$ref": "#/$defs/fillRule"
            }
          }
        }
      ]
    },
    "element": {
      "oneOf": [
        {
