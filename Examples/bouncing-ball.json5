// A bouncing ball: easeOut going up and easeIn coming down, squashed when it lands, with a shadow that shrinks as
// the ball rises. HEIGHT runs 0 (on the floor) to 1 (top of the bounce).
{
  $schema: "../Schema/vectorscript.schema.json",
  animation: { duration: 1.4, fps: 30 },
  parameters: {
    T: "$TIME / $DURATION",
    HEIGHT: "if($T < 0.5, easeOut($T * 2), easeOut(2 - $T * 2))",
    FLOOR: 150,
    RISE: 110,
    R: 18,
    // Squash near the floor: wide and short in the first and last few percent of the loop.
    SQUASH: "max(0, 1 - min($T, 1 - $T) * 14) * 0.35",
    Y: "$FLOOR - $R * (1 - $SQUASH) - $HEIGHT * $RISE"
  },
  size: [160, 180],
  elements: [
    { rect: [0, 0, 160, 180], fill: { linearGradient: { from: [0, 0], to: [0, 1], stops: [[0, "#f4f1ea"], [1, "#e2dccf"]] } } },
    { rect: [0, "$FLOOR", 160, 30], fill: "#cfc6b5" },
    { ellipse: [80, "$FLOOR + 2", "$R * (1.3 - $HEIGHT * 0.7)", "4 * (1 - $HEIGHT * 0.6)"], fill: "#00000040", filter: { blur: 2 } },
    { circle: [0, 0, "$R"], transform: "translate(80 {$Y}) scale({1 + $SQUASH} {1 - $SQUASH})",
      fill: { radialGradient: { focus: [0.35, 0.3], stops: [[0, "#ffd0c4"], [0.4, "#ef5a3c"], [1, "#a32d16"]] } } }
  ]
}
