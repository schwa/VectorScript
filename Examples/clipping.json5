// clip limits an element or group to a shape, in the element's own coordinates. On a use, the clip is not moved by at.
{
  $schema: "../Schema/vectorscript.schema.json",
  size: [360, 200],
  background: "#fff",
  defs: {
    stripes: { group: [
        { rect: [0, 0, 120, 160], fill: "#f0a830" },
        { path: "M -40 160 L 40 0 H 60 L -20 160 Z M 0 160 L 80 0 H 100 L 20 160 Z M 40 160 L 120 0 H 140 L 60 160 Z M 80 160 L 160 0 H 180 L 100 160 Z", fill: "#222" }
      ] }
  },
  elements: [
    { use: "stripes", at: [10, 20], clip: { circle: [70, 100, 55] } },
    { use: "stripes", at: [130, 20], clip: { rect: [140, 40, 100, 120], radius: 24 } },
    // An evenodd path clip makes a frame.
    { use: "stripes", at: [240, 20], clip: { path: "M 245 25 H 355 V 175 H 245 Z M 270 50 V 150 H 330 V 50 Z", fillRule: "evenodd" } },
    { circle: [70, 100, 55], fill: "none", stroke: "#999", strokeDash: [4, 4] }
  ]
}
