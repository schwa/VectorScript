// Markers: elements drawn at the vertices of paths, lines, polylines and polygons. markerStart, markerMid and
// markerEnd name an element in defs (or hold one inline as { element, orient }). They inherit like other style
// keys; "none" cancels one. orient is auto (along the path, the default), auto-start-reverse, or degrees.
// Each marker's origin sits on its vertex, and +x points along the path.
{
  $schema: "../Schema/vectorscript.schema.json",
  size: [360, 260],
  background: "#fff",
  defs: {
    arrow: { path: "M 0 0 L -10 -5 L -7 0 L -10 5 Z", fill: "#222" },
    dot: { circle: [0, 0, 3.5], fill: "#fff", stroke: "#222", strokeWidth: 1.5 },
    tick: { line: [0, -5, 0, 5], stroke: "#d9483b", strokeWidth: 2 }
  },
  elements: [
    // An arrow at the end of a line, and at both ends with auto-start-reverse.
    { line: [20, 30, 160, 30], stroke: "#222", strokeWidth: 2, markerEnd: "arrow" },
    { line: [200, 30, 340, 30], stroke: "#222", strokeWidth: 2, markerStart: { name: "arrow", orient: "auto-start-reverse" }, markerEnd: "arrow" },

    // Dots on every vertex of a chart line: mid markers on the inner points.
    { polyline: [[20, 140], [70, 90], [120, 110], [170, 60], [220, 100], [270, 70], [340, 120]],
      fill: "none", stroke: "#3b8fd9", strokeWidth: 2.5, markerStart: "dot", markerMid: "dot", markerEnd: "arrow" },

    // Markers follow curves: ticks along a wave, and an arrow on an arc.
    { path: "M 20 200 Q 45 160 70 200 T 120 200 T 170 200 T 220 200", fill: "none", stroke: "#999", strokeWidth: 1.5,
      markerMid: "tick", markerEnd: "arrow" },
    { path: "M 250 245 A 45 45 0 1 1 330 245", fill: "none", stroke: "#4bb06a", strokeWidth: 2, markerEnd: { name: "arrow", orient: "auto" } },

    // Inherited from a group; the polygon closes back to its start, where markerEnd lands.
    { group: [
        { polygon: [[240, 130], [280, 140], [260, 165]] },
        { polyline: [[295, 135], [330, 145], [315, 168]], markerEnd: "none" }
      ], fill: "none", stroke: "#8a5cc2", strokeWidth: 1.5, markerStart: "dot", markerMid: "dot", markerEnd: "dot" }
  ]
}
