{ size: [200, 120], background: "#fff",
  defs: { sunset: { linearGradient: { from: [0, 0], to: [0, 1], stops: [[0, "#fd5"], [0.5, "#f63"], [1, "#609"]] } } },
  elements: [
    { rect: [10, 10, 80, 100], fill: "$sunset" },
    { circle: [140, 40, 30], fill: { radialGradient: { focus: [0.3, 0.3], stops: [[0, "#fff"], [1, "#048"]] } } },
    { rect: [110, 80, 80, 30], fill: { linearGradient: { from: [110, 0], to: [190, 0], units: "user", stops: [[0, "red"], [1, "#00f0"]] } } },
    { rect: [20, 50, 60, 20], fill: "#0008", stroke: { linearGradient: { stops: [[0, "lime"], [1, "navy"]] } }, strokeWidth: 4 }
  ] }
