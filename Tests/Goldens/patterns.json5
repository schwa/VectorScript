{ size: [200, 120], background: "#fff",
  defs: {
    checker: { pattern: { size: [10, 10], elements: [ { rect: [0, 0, 5, 5], fill: "#888" }, { rect: [5, 5, 5, 5], fill: "#888" } ] } },
    stripes: { pattern: { size: [12, 12], transform: "rotate(30)", elements: [ { rect: [0, 0, 12, 12], fill: "#fc3" }, { rect: [0, 0, 12, 6], fill: "#222" } ] } }
  },
  elements: [
    { rect: [10, 10, 80, 100], fill: "$checker" },
    { circle: [145, 45, 35], fill: "$stripes" },
    { rect: [110, 90, 80, 20], fill: "none", stroke: "$stripes", strokeWidth: 8 },
    { rect: [20, 20, 60, 30], fill: { pattern: { size: [8, 8], transform: "translate(2 2)", elements: [ { circle: [4, 4, 2.5], fill: "#c33" } ] } } }
  ] }
